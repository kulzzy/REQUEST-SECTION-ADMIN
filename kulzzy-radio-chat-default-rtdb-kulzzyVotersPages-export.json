    "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n\n<title>FACE OF KULZZY RADIO 2026</title>\n\n<style>\nhtml,\nbody{\n    margin:0 !important;\n    padding:0 !important;\n    width:100% !important;\n    background:#07152f !important;\n    font-family:Arial,Helvetica,sans-serif;\n}\n\n*{\n    box-sizing:border-box;\n}\n\n.face-wrapper{\n    width:100%;\n    max-width:100%;\n    margin:0 auto;\n    padding:0;\n    background:#07152f;\n}\n\n/* HEADER */\n.face-header{\n    width:100%;\n    background:#07152f;\n    border-bottom:3px solid #f5c542;\n    padding:15px 10px;\n    text-align:center;\n}\n\n.face-header h1{\n    margin:0;\n    padding:0;\n    color:#f5c542;\n    font-size:clamp(22px,5vw,38px);\n    font-weight:900;\n    line-height:1.2;\n}\n\n.face-header p{\n    margin:6px 0 0;\n    color:#ffffff;\n    font-size:clamp(12px,3vw,16px);\n    font-weight:bold;\n}\n\n/* CONTENT */\n.face-content{\n    width:100%;\n    background:#07152f;\n    padding:12px 0 0;\n}\n\n/* RESPONSIVE FRAME */\n.face-frame{\n    width:100%;\n    height:calc(100vh - 80px);\n    min-height:650px;\n    border:0;\n    display:block;\n    background:#ffffff;\n}\n\n/* MOBILE */\n@media(max-width:600px){\n\n    .face-header{\n        padding:12px 8px;\n    }\n\n    .face-header h1{\n        font-size:22px;\n    }\n\n    .face-header p{\n        font-size:12px;\n    }\n\n    .face-content{\n        padding:0;\n    }\n\n    .face-frame{\n        width:100%;\n        height:calc(100vh - 90px);\n        min-height:650px;\n    }\n}\n\n/* TABLET */\n@media(min-width:601px) and (max-width:1000px){\n\n    .face-frame{\n        min-height:700px;\n    }\n}\n\n/* DESKTOP */\n@media(min-width:1001px){\n\n    .face-frame{\n        min-height:800px;\n    }\n}\n</style>\n</head>\n\n<body>\n\n<div class=\"face-wrapper\">\n\n    <header class=\"face-header\">\n\n        <h1>\n            👑 FACE OF KULZZY RADIO 2026\n        </h1>\n\n        <p>\n            VOTE FOR YOUR FAVOURITE CONTESTANT\n        </p>\n\n    </header>\n\n    <main class=\"face-content\">\n\n        <iframe\n            class=\"face-frame\"\n            src=\"https://kulzzy.github.io/FACE-OF-KULZZY-RADIO-/\"\n            title=\"FACE OF KULZZY RADIO 2026\"\n            allow=\"payment\"\n            loading=\"eager\">\n        </iframe>\n\n    </main>\n\n</div>\n\n</body>\n</html>",
